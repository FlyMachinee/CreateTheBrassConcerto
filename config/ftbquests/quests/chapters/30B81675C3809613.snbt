		}
		{
			description: [
				"&e在正常情况下，1 秒(1000 毫秒)为 20 tick"
				""
				"&e然而，由于&r&a世界不稳定度&r&e的影响，1 tick可能会长于 50 毫秒"
				""
				"&e具体计算公式为："
				""
				"1 tick = 1*max\\{50 , mspt\\} (单位为毫秒)"
				""
				"1 天 = 24000 tick"
				""
				"&o注: max\\{ \\}表示取其中最大的值"
			]
			icon: "minecraft:bell"
			id: "0043A7E99CF985B3"
			shape: "rsquare"
			tasks: [{
				id: "7EB0EFC0705347BD"
