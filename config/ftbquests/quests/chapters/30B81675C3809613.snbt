		}
		{
			description: [
				"&e流体常使用两种单位：mB (毫桶) 和 B (桶)"
				""
				"&e他们的关系是：1B = 1000mB"
				""
				"&e一般而言, 1 金属锭= 90mB 熔融金属"
				""
				"&e下面给出一些常用的流体数量："
				"90 &7(9*10 - 1 金属锭)"
				"810 &7(9*90 - 1 金属块)"
				"1080 &7(12*90 - 12 金属锭)"
				"2160 &7(24*90 - 24 金属锭)"
				"2880 &7(32*90 - 32 金属锭)"
				"3240 &7(32*90 - 36 金属锭)"
				"4320 &7(48*90 - 48 金属锭)"
			]
			icon: "design_decor:copper_gas_tank"
			id: "59EC882B083BE3F4"
