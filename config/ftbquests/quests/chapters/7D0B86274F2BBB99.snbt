	quest_links: [ ]
	quests: [
		{
			dependencies: ["12791AC9AE74A060"]
			description: [
				"&a相信到这里，你已经准备好了化工与电力的基础。&r"
				""
				"在将目光放到群星之间之前，让我们先关注怎样让这片土地上的微生物也成为我们的助力。"
				""
				"这些细微的生物能帮助我们创造最伟大的工程。"
				""
				"&e在这一小节中，你需要翻山越岭，寻找各种不同微生物的聚居地，并学会怎样使用它们来让生产更高端、更高效。&r"
			]
			id: "3456E20C70FA102A"
			shape: "gear"
			size: 1.25d
			tasks: [{
				id: "70FE2BD16CEFD753"
				type: "checkmark"
			}]
			title: "看向细微之处"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: [
				"12791AC9AE74A060"
				"223775466012800D"
			]
			description: [
				"让我们从培养仓开始吧！"
				""
				"黄铜培养仓是获得大部分微生物的必须设备"
				""
				"&a黄铜培养仓可以自动向周围（六向）的容器输出产物——而传送带也是容器！&r"
				""
				"&e黄铜培养仓会以如下次序依次检测并输出：下-上-北-南-西-东&r"
				""
				"&e黄铜培养仓会使得它附近未设置过滤的溜槽不能正常工作——内在逻辑是对于自动输出而言，未设置过滤=仅有空气能通过过滤！&r"
				""
				"&a你一般需要在对应的生物群系使用合适的培养基来获得对应的微生物&r。对于大部分微生物来说，你只需要获得第一个母本，接着就可以大量培养了"
				""
				"&e你可以在配方中查看微生物具体需要的生物群系，将鼠标移至左下角的空白地图图标处即可显示&r"
				"{image:kubejs:textures/ftb/culture_bin.png width:100 height:120 align:left}"
				"&e你可以在思索中查看如何进行精确混带！&r"
			]
			id: "2BDD1C7FA08793B2"
			size: 1.5d
			tasks: [
				{
					id: "7AC02CC7C4D66E99"
					item: "kubejs:culture_bin"
					type: "item"
				}
				{
					id: "55BBD80E58209CFA"
					item: "kubejs:empty_culture_plate"
					type: "item"
				}
			]
			title: "温床"
			x: 0.0d
			y: -1.5d
		}
		{
			dependencies: ["2BDD1C7FA08793B2"]
			description: [
				"异彩原虫是一种来自于末地的微生物，它们代表着末地曾经繁华的过去。"
				""
				"在大撕裂中，末地的几乎所有水源被抽干并汇入了主世界，于是异彩原虫的祖先们的生存也变得艰难了起来。经过若干年的演化，几乎不需要水分的异彩原虫代替了它的祖先们。"
				""
				"你可以使用它来转化不同的染料，并制造异彩废料"
				""
				"&e你可以在配方左下角的空白地图图标中查看该微生物具体需要的生物群系&r"
			]
			id: "5F6416692710B704"
			tasks: [{
				id: "7514E5DCFF7C0B82"
				item: "kubejs:chromatic_protozoa"
				type: "item"
			}]
			x: 1.0d
			y: 1.0d
		}
		{
			dependencies: ["2BDD1C7FA08793B2"]
			description: [
				"泥炭原虫栖息在沼泽地、蘑菇地和茂盛的丛林中"
				""
				"它能够将泥胚转化为木炭，然后在将木炭转化为煤炭的同时将泥巴转化为泥胚"
				""
				"&e你可以在配方左下角的空白地图图标中查看该微生物具体需要的生物群系&r"
			]
			id: "791989AD3A1B2555"
			tasks: [{
				id: "5311564F6C215DDB"
				item: "kubejs:peat_protozoa"
				type: "item"
			}]
			x: -2.0d
			y: -1.0d
		}
		{
			dependencies: ["2BDD1C7FA08793B2"]
			description: [
				"金属原虫是一种能够将基础金属彼此转化的微生物"
				""
				"于是，通过它，你终于可以批量生产银了"
				""
				"&e你可以在一些比较古老的矿物中发现它&r"
			]
			id: "09A9BB62F0A2D207"
			tasks: [{
				id: "20487F4CF2326485"
				item: "kubejs:metal_protozoa"
				type: "item"
			}]
			x: 2.0d
			y: 1.0d
		}
		{
			dependencies: ["2BDD1C7FA08793B2"]
			description: [
				"蓝焰衣原体是烈焰支原体的祖先，它们曾在大撕裂带来的大量高能燃料中生存，但在下界的高能燃料逐渐枯竭后便渐渐从下界中消失"
				""
				"你可以利用它们来创造比超级加热更高温的环境，这将能够用于诸多重要的配方——比如过热蒸汽、碳化硅、石墨烯"
				""
				"除此以外，它也是踏入太空时代的必备品——它可以用于炼钢"
				""
				"如果你需要大量的衣原体，你可以考虑通过烈焰蛋糕来生产"
				""
				"&e你可以在配方左下角的空白地图图标中查看该微生物具体需要的生物群系&r"
			]
