	id: "158AAB195C2FD998"
	order_index: 2
	quest_links: [ ]
	quests: [
		{
			dependencies: [
				"70B71AF12951D64D"
				"51950D03F6955270"
			]
			description: [
				"到这里，你应该已经建立了基础的铝工业、计算机阵列和轨道空间站。"
				""
				"为了将异星与地球、轨道与地面紧紧地联系在一起，&e在这一小节中，你需要发展光学设备、建立完善的星际物流网络——而不是用那个麻烦且不好用的一阶小火箭手动到处搬运。&r"
				""
				"&a除此以外，卫星能够从轨道定位地面的矿脉，能够从太空中获取矿物；谐振原虫可以制造无线传输工具、可以催使微生物变异、可以用于快捷生产光学设备......&r"
				""
				"&e为了将星球链在一起，让火箭划破天际吧！&r"
			]
			id: "31AFEA4398EA2066"
			shape: "gear"
			size: 1.25d
			tasks: [{
				id: "70074A3D8964079F"
				type: "checkmark"
			}]
			title: "让我们将目光上抬"
			x: -5.0d
			y: -5.0d
		}
		{
			dependencies: ["1C1506C65C415E2E"]
			description: [
				"利用轨道卫星收发站，你可以通过人造卫星获取轨道导航信息、扫描星球矿脉、批量获取谐振原虫、甚至是太空采矿！"
				""
				"&e你可以使用黄铜维修盒或火箭维修盒来修复卫星&r"
				""
				"输入槽中的空硬盘会自动转移至输出槽"
				""
				"&a在思索中查看具体结构或使用蓝图打印！请注意：蓝图不包含控制器&r"
				""
				"&o温馨提示：如果莫名其妙停止工作，可以检查是否是区块掉加载导致的问题！&r"
				""
				"&e人造卫星的工作配方时间为480tick！"
			]
			id: "12490AA2AE2A6A94"
			tasks: [{
				id: "085D367C7BF3D53B"
				item: "kubejs:satellite_station"
				type: "item"
			}]
			x: -3.0d
			y: -2.0d
		}
		{
			dependencies: [
				"1CC2F54948B93801"
				"12490AA2AE2A6A94"
			]
			description: [
				"利用火箭发射台，你可以通过运载火箭建立自动化的星际物流网络！除此以外，你也可以随着运载火箭快捷地前往各个星球"
				""
				"[ \"如果你需要运送流体的话，你可以考虑使用\", { \"text\": \"密封储罐\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"37B807F2628934C1\" } }, \"！\" ]"
				""
				"&a在轨道发射运载火箭时，消耗的材料会更少！&r"
				""
				"&e需要注意的是，火箭自身不带有强加载！&r"
				""
				"&a在思索中查看具体结构或使用蓝图打印！请注意：蓝图不包含控制器，并且标注了方向的蓝图不能旋转！&r"
				""
				"&o温馨提示：如果莫名其妙停止工作，可以检查是否是区块掉加载导致的问题！&r"
				""
				"&e火箭的发射配方时间为320tick&r"
			]
			id: "70663CE0980E8D83"
			tasks: [{
				id: "0DFE5BEC9A9B17A7"
				item: "kubejs:launch_pad_controller"
				type: "item"
			}]
			x: -5.0d
			y: -2.0d
		}
		{
			dependencies: ["2EA1F89222316AAE"]
			description: ["这种材料具有许多神奇的电学特性，使得它可以用于制造特殊设备、生产电流体等等"]
			id: "1708943F05EEA16C"
			tasks: [{
				id: "220B47ABF5496B7F"
				item: "create:refined_radiance"
				type: "item"
			}]
			x: 1.0d
			y: -2.0d
		}
		{
			dependencies: ["3C1C9C11E7911ACB"]
			description: [
				"为了获取基础信息素、加工光学元件，你会需要这台机械的！"
				""
				"你还可以用它制造光辉石！"
				""
				"需要注意的是，它同时需要应力与电能！"
			]
			id: "2EA1F89222316AAE"
			tasks: [{
				id: "047D3765A43EC29C"
				item: "vintageimprovements:laser"
				type: "item"
			}]
			x: 1.0d
			y: -3.5d
		}
		{
			dependencies: ["60FCB2079415FD71"]
			description: ["你需要利用光学元件来制造卫星、卫星测地模块、卫星太空采矿模块等一系列需要精密光学元件的设备！"]
			id: "3C1C9C11E7911ACB"
			tasks: [{
				id: "0BACAC67619DA830"
				item: "kubejs:optical_device"
				type: "item"
			}]
			x: -1.0d
			y: -3.5d
		}
		{
			description: [
				"碳化硅透镜是一种光学性质优良的透镜，用于制造许多光学设备"
				""
				"&a其配方中的第二步，盐酸应输入至工作盆中！&r"
			]
			id: "60FCB2079415FD71"
			tasks: [{
				id: "3BC08DCD711F8E25"
				item: "kubejs:carborundum_lens"
				type: "item"
			}]
			x: -1.0d
			y: -5.0d
		}
		{
			dependencies: ["3C1C9C11E7911ACB"]
			description: [
				"卫星探测模块用于获取导航数据、地面矿脉位置等信息"
				""
				"它是不消耗的，你只需要将它放入轨道卫星收发站即可"
				""
				"除此以外，它还有一个本地探测模式——&e在本地探测模式下的卫星探测模块一次可以获取更多导航数据，但是只能获取所在星球的导航数据&r"
			]
			id: "297751E85121AA3E"
			rewards: [{
				id: "35197B19A8C6B5A9"
				item: "kubejs:satellite_scanning_module_local"
				type: "item"
			}]
			tasks: [{
				id: "53FB23F20131BB98"
				item: "kubejs:satellite_scanning_module"
				type: "item"
			}]
			x: -3.0d
			y: -3.5d
		}
		{
			dependencies: ["297751E85121AA3E"]
			description: [
				"数据存储芯片用于存储火箭的导航信息！"
				""
				"利用人造卫星来获取导航信息！"
				""
				"需要注意的是，你可以将星球轨道的导航数据与星球地面的导航数据进行无损转化！"
				""
				"除此以外，你还可以制作&a坐标数据芯片&r！&e使用它为发射台设置过滤后，可以让火箭降落在其绑定的坐标处（降落的星球仍然由导航芯片决定）！&r"
			]
			id: "1CC2F54948B93801"
			tasks: [{
				id: "3EB2BB79A2E072E9"
				item: "kubejs:navigate_data_empty"
				type: "item"
			}]
			x: -5.0d
			y: -3.5d
		}
		{
			dependencies: ["1708943F05EEA16C"]
			description: [
				"人造卫星利用太阳能和霍尔推进器在宇宙空间中活动"
				""
				"你无需为它提供电能，但需要提供用于维修的零件盒和散热片，以及用作推进剂的氢。"
				""
				"在获取太空电梯之后，你可以极大地简化它的生产！"
