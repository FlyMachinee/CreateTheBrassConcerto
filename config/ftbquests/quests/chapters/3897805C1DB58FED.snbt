							[
								0
								-1
							]
						]
					]
				}
			}
			id: "7800372D4BACA970"
			tasks: [{
				id: "189B96EB8DEC33D1"
				title: "常用矩阵术语"
				type: "checkmark"
			}]
			x: -7.5d
			y: -6.0d
		}
		{
			dependencies: ["7800372D4BACA970"]
			description: [
				"&6矩阵的记号：&r&e虽然没有硬性规定，但一般我们用大写字母来表示一个矩阵"
				""
				"&6单位矩阵：&r&e对角线元素均为1的对角方阵，常用I或者E来代指"
				""
				"&6零矩阵：&r&e元素均为0的矩阵，常用O来代指"
				""
				"&6转置：&r&e将矩阵沿对角线翻转的操作称为转置，得到的矩阵一般记为A^T（^表示上标）"
				""
				"&6反转置：&r&e将矩阵沿反对角线翻转的操作称为反转置，得到的矩阵我们记为A^iT（^表示上标）"
				""
				"&6初等行/列变换：&r&e如下操作称为初等行/列变换：1.交换某两行/列；2.将某一行/列乘以一个倍数后加到或减到另一行/列；3.将某一行/列乘上一个非零倍数&a（为了便于理解，此处将2、3拆开了。实际上，2、3可以合并为同一种操作）&r"
			]
			icon: {
				Count: 1
				id: "kubejs:matrix_2"
				tag: {
